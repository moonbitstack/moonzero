  "moonbitstack/moonzero/proc",
  "moonbitstack/moonzero/conf",
  "moonbitstack/moonzero/clock",
  "moonbitstack/moonzero/logx",
  "moonbitstack/moonzero/breaker",
  "moonbitstack/moonzero/shedder",
  "moonbitstack/moonzero/telemetry",
  "moonbitstack/moonhttp/http2",
  "moonbitstack/moonrpc",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/hpack",
  "moonbitstack/moonp8s",
  "moonbitstack/moonp8s/metric",
  "moonbitstack/moontel/trace",
}

import {
  "moonbitstack/moonlog",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"
