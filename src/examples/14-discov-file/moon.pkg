// The file backend reads a real file through `moonbitlang/async`'s fs, so this example is
// native-only, like the package.
supported_targets = "native"

import {
  "moonbitstack/moonzero",
  "moonbitstack/moonzero/discov",
  "moonbitstack/moonsd/memory",
  "moonbitlang/async",
  "moonbitlang/async/fs",
}

pkgtype(kind: "executable")
