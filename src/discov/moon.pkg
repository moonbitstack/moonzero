// A moonsd backend over a file: one process writes a snapshot, others read and watch it. Native
// only, because `moonbitlang/async`'s fs has no JS or Wasm backend. The tests of the live services
// are here too, since an async test needs a real event loop.
supported_targets = "native"

import {
  "moonbitstack/moonsd",
  "moonbitstack/moonsd/memory",
  "moonbitlang/async/fs",
}

import {
  "moonbitstack/moonzero",
  "moonbitstack/moonapi",
  "moonbitstack/moonasgi",
  "moonbitstack/moonconsul/fetch",
  "moonbitstack/moonconsul/sd" @consul_sd,
  "moonbitstack/moonetcd",
  "moonbitstack/moonetcd/client",
  "moonbitstack/moonetcd/sd" @etcd_sd,
  "moonbitstack/moonredis",
  "moonbitstack/moonredis/resp",
  "moonbitstack/moonredis/sd" @redis_sd,
  "moonbitstack/moonredis/socket",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitstack/moonlog",
  "moonbitstack/moonbase/base16",
  "moonbitstack/mooncrypt/hash/sha2",
} for "test"
