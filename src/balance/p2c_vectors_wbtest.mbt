///|
/// Every row, in the order the reference emitted them.
fn p2c_vectors() -> Array[P2cVector] {
  [
    ..p2c_vectors_1(),
    ..p2c_vectors_2(),
    ..p2c_vectors_3(),
    ..p2c_vectors_4(),
    ..p2c_vectors_5(),
    ..p2c_vectors_6(),
    ..p2c_vectors_7(),
    ..p2c_vectors_8(),
    ..p2c_vectors_9(),
    ..p2c_vectors_10(),
    ..p2c_vectors_11(),
  ]
}
